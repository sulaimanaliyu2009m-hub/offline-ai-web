# Copy this file to .env and replace example values on your own computer.
# Never commit .env or share its values.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:1b

# Optional public-host mode. Do not enable this on an untrusted host without HTTPS.
# AI_PROVIDER=cloudflare
# CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.1-8b-instruct

# Optional email verification and password reset
# SMTP_HOST=smtp.gmail.com
# SMTP_USERNAME=your-address@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-address@example.com
# SMTP_PORT=587

# Optional image generation and image understanding
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-workers-ai-token

# Optional admin account
# ADMIN_PASSWORD=generate-a-unique-long-password
